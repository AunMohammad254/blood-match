# ─────────────────────────────────────────────────────────────
#  BloodMatch — Environment Variable Reference
#  Copy this file to .env.local and fill in real values.
#  NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bloodmatch
MONGODB_USERNAME=your_db_username
MONGODB_PASSWORD=your_db_password

# Authentication
JWT_SECRET=generate_a_random_64_hex_character_string_here

# AI Features (Optional)
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Email — Brevo (Sendinblue) SMTP ──────────────────────────
# Get SMTP credentials from: Brevo dashboard → SMTP & API → SMTP
# SMTP_USER = your Brevo account login email
# SMTP_PASS = your Brevo SMTP key (starts with xkeysib-)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@example.com
SMTP_PASS=xkeysib-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX-XXXXXXXX
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=BloodMatch

# Admin alert email — receives critical blood request and report alerts
ADMIN_ALERT_EMAIL=admin@yourdomain.com

# Application
NODE_ENV=development
